APP_NAME="PrepareMe API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=prepareme_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@prepareme.com"
MAIL_FROM_NAME="${APP_NAME}"

OCR_DRIVER=dev
OCR_LANGUAGE_DEFAULT=ben+eng
OCR_MAX_FILE_SIZE_MB=10
OCR_ALLOWED_MIMES=image/jpeg,image/png,image/webp,image/tiff
OCR_TESSERACT_PATH=
GOOGLE_VISION_KEY_PATH=
