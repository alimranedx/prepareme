# Root Gitignore
prepareme-api/vendor/
prepareme-api/node_modules/
prepareme-api/.env
prepareme-api/.env.*
!prepareme-api/.env.example
prepareme-api/storage/*.key
prepareme-api/storage/logs/*
prepareme-api/storage/framework/cache/*
prepareme-api/storage/framework/sessions/*
prepareme-api/storage/framework/views/*
prepareme-api/storage/app/private/*
!prepareme-api/storage/app/private/.gitignore
prepareme-api/database/*.sqlite
prepareme-api/database/*.sqlite-journal

prepareme-web/node_modules/
prepareme-web/dist/
prepareme-web/.env
prepareme-web/.env.local
prepareme-web/.env.*
!prepareme-web/.env.example

*.stackdump
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
